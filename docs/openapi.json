          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "text"
        ],
        "title": "SourcePage"
      },
      "TokenUsage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
