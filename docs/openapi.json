  "components": {
    "schemas": {
      "AnalysisResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "openai"
            ],
            "title": "Mode"
          },
          "provider_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Model"
          },
          "sample": {
            "type": "boolean",
            "title": "Sample"
          },
          "analyzed_at": {
            "type": "string",
            "title": "Analyzed At"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          },
          "status": {
            "type": "string",
            "enum": [
              "checks_passed",
              "needs_review"
            ],
            "title": "Status"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ReviewField"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Fields"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Findings"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/SourcePage"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Pages"
          },
          "notices": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notices"
          },
          "token_usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TokenUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "filename",
          "page_count",
          "mode",
          "provider_model",
          "sample",
          "analyzed_at",
          "elapsed_ms",
          "status",
          "fields",
          "findings",
          "pages",
          "notices"
        ],
        "title": "AnalysisResult"
      },
