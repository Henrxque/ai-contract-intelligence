# Optional: local rules and synthetic samples work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set true only to enable the LLM option. Uploads in this mode send PDF text to OpenAI.
ENABLE_OPENAI=false
# Durable batch mode only. PDFs, extracted text and results are stored in this local DB.
PIPELINE_DB_PATH=data/pipeline.sqlite3
